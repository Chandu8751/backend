# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas free tier (M0) works great here, e.g.:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lnn?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/lnn

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS) — set this to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173

# --- Image/video uploads ---
# Recommended for production: create a free Cloudinary account (cloudinary.com) and
# fill these in. When set, uploads go straight to Cloudinary's CDN, which is required
# on most free hosts (Render/Railway/Vercel wipe the local filesystem on every
# restart/deploy, so local storage alone will lose your images).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local disk fallback — only used when the Cloudinary vars above are blank. Fine for
# local development; not reliable in production on most free hosts.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
